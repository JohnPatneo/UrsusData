---
import BaseLayout from "../../layouts/BaseLayout.astro";

const services = [
  {
    number: "S1",
    title: "Data Engineering",
    description: "Build robust data pipelines and infrastructure to collect, transform, process, and integrate data from multiple sources.",
  },
  {
    number: "S2",
    title: "Business Intelligence",
    description: "Turn complex datasets into intuitive dashboards and reporting solutions that give teams a clear view of their business.",
  },
  {
    number: "S3",
    title: "Data Analytics",
    description: "Explore data, identify patterns, and uncover actionable insights that support smarter and more informed decisions.",
  },
  {
    number: "S4",
    title: "Data Quality",
    description: "Improve the reliability of your data through validation, cleansing, testing, and monitoring processes that ensure trusted information.",
  },
  {
    number: "S5",
    title: "Automation",
    description: "Reduce repetitive manual processes by automating data workflows, reporting, validation, and other operational tasks.",
  },
  {
    number: "S6",
    title: "Maintenance",
    description: "Define the right architecture, tools, processes, and roadmap to build a data environment that can scale with your business.",
  },
];
---

<BaseLayout
  title="Data Engineering & Analytics Services | UrsusData"
  description="Explore UrsusData services: data engineering and integration, business intelligence and analytics, data quality, and automation."
  currentPage="services"
>
  <main>
    <section class="hero">
      <div class="fade-up">
        <p class="eyebrow">Services</p>
        <h1>From raw data to real business value</h1>
        <p class="lead">
          We design and build data solutions that make information easier to collect, process,
          understand, and act on. Every service is focused on reliability, scalability, and
          measurable business impact.
        </p>
        <div class="actions">
          <a class="btn btn-primary" href="/contact/">Start a conversation</a>
        </div>
      </div>
    </section>
    <section class="section cards">
      {services.map(({ number, title, description }) => (
        <article class="card fade-up">
          <div class="icon" aria-hidden="true">{number}</div>
          <h2>{title}</h2>
          <p>{description}</p>
        </article>
      ))}
    </section>
  </main>
</BaseLayout>
